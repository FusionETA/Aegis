# Argus console web app (https://argus.fusioneta.com.my via Caddy). Unprivileged user
# argus-web; can't read /root. Talks to Argus only through argus-agent.service.
[Unit]
Description=Argus console web app
After=network-online.target argus-agent.service
Wants=argus-agent.service

[Service]
User=argus-web
Group=argus-web
WorkingDirectory=/opt/argus-console
ExecStart=/opt/node24/bin/node /opt/argus-console/server.js
Environment=CONSOLE_PORT=3200
Environment=CONSOLE_HOST=127.0.0.1
Environment=CONSOLE_URL=https://argus.fusioneta.com.my
Environment=CONSOLE_DATA_DIR=/var/lib/argus-console
Environment=AGENT_SOCKET=/run/argus-agent/agent.sock
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/argus-console
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
