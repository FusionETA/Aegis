# Aegis console agent: the only console part with access to /root/aegis (runs as root).
# Answers a fixed, validated list of operations on /run/aegis-agent/agent.sock (group aegis-web).
[Unit]
Description=Aegis console agent
After=network-online.target

[Service]
ExecStart=/opt/node24/bin/node /root/aegis/console/agent.js
Environment=AEGIS_HOME=/root/aegis
Environment=AGENT_SOCKET=/run/aegis-agent/agent.sock
Environment=AGENT_GROUP=aegis-web
Environment=AEGIS_NODE=/opt/node24/bin/node
Environment=CONSOLE_URL=https://aegis.fusioneta.com.my
RuntimeDirectory=aegis-agent
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
