# Argus console agent: the only console part with access to /root/argus (runs as root).
# Answers a fixed, validated list of operations on /run/argus-agent/agent.sock (group argus-web).
[Unit]
Description=Argus console agent
After=network-online.target

[Service]
ExecStart=/opt/node24/bin/node /root/argus/console/agent.js
Environment=ARGUS_HOME=/root/argus
Environment=AGENT_SOCKET=/run/argus-agent/agent.sock
Environment=AGENT_GROUP=argus-web
Environment=ARGUS_NODE=/opt/node24/bin/node
Environment=CONSOLE_URL=https://argus.fusioneta.com.my
RuntimeDirectory=argus-agent
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
